# Copy to .env and fill in only when you are deliberately leaving
# dress-rehearsal mode. See docs/SAFETY.md first.

# Safety switch. Leave this alone until you mean it.
CHRONO_AUDIT_DRESS_REHEARSAL=true

# CALL-E credentials (unused while dress rehearsal is true).
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Decision policy tuning.
CHRONO_AUDIT_ENTAILMENT_THRESHOLD=0.65
CHRONO_AUDIT_MAX_HOPS=2
CHRONO_AUDIT_MAX_CALL_SECONDS=180

# GitHub integration (only needed to post comments/status back to a PR).
GITHUB_TOKEN=
GITHUB_REPOSITORY=
